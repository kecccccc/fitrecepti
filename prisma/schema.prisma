generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role          @default(USER)
  createdAt    DateTime      @default(now()) @map("created_at")
  comments     Comment[]
  ratings      Rating[]
  recipes      Recipe[]
  saved        SavedRecipe[]

  @@map("users")
}

model Ingredient {
  id                String             @id @default(uuid())
  name              String
  source            String
  sourceId          String             @map("source_id")
  kcalPer100g       Decimal            @map("kcal_per_100g") @db.Decimal(7, 2)
  proteinPer100g    Decimal            @map("protein_per_100g") @db.Decimal(6, 2)
  carbsPer100g      Decimal            @map("carbs_per_100g") @db.Decimal(6, 2)
  fatPer100g        Decimal            @map("fat_per_100g") @db.Decimal(6, 2)
  refreshedAt       DateTime           @default(now()) @map("refreshed_at")
  nameSr            String             @map("name_sr")
  recipeIngredients RecipeIngredient[]

  @@unique([source, sourceId])
  @@index([name])
  @@index([nameSr])
  @@map("ingredients")
}

model Recipe {
  id                String                 @id @default(uuid())
  authorId          String                 @map("author_id")
  title             String
  description       String
  instructions      String
  imageUrl          String?                @map("image_url")
  servings          Int
  kcalPerServing    Decimal                @map("kcal_per_serving") @db.Decimal(8, 2)
  proteinPerServing Decimal                @map("protein_per_serving") @db.Decimal(7, 2)
  carbsPerServing   Decimal                @map("carbs_per_serving") @db.Decimal(7, 2)
  fatPerServing     Decimal                @map("fat_per_serving") @db.Decimal(7, 2)
  embedding         Unsupported("vector")?
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  comments          Comment[]
  ratings           Rating[]
  ingredients       RecipeIngredient[]
  tags              RecipeTag[]
  author            User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  savedBy           SavedRecipe[]

  @@index([kcalPerServing])
  @@index([proteinPerServing])
  @@index([createdAt])
  @@map("recipes")
}

model RecipeIngredient {
  recipeId     String     @map("recipe_id")
  ingredientId String     @map("ingredient_id")
  amountGrams  Decimal    @map("amount_grams") @db.Decimal(8, 2)
  position     Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model Tag {
  id      String      @id @default(uuid())
  name    String      @unique
  recipes RecipeTag[]

  @@map("tags")
}

model RecipeTag {
  recipeId String @map("recipe_id")
  tagId    String @map("tag_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@map("recipe_tags")
}

model SavedRecipe {
  userId    String   @map("user_id")
  recipeId  String   @map("recipe_id")
  createdAt DateTime @default(now()) @map("created_at")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@map("saved_recipes")
}

model Rating {
  userId    String   @map("user_id")
  recipeId  String   @map("recipe_id")
  value     Int
  createdAt DateTime @default(now()) @map("created_at")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@map("ratings")
}

model Comment {
  id        String   @id @default(uuid())
  recipeId  String   @map("recipe_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("comments")
}

enum Role {
  USER
  ADMIN
}
